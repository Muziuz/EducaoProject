<%- include('includes/head') %>
<link rel="stylesheet" href="/assets/css/logicgame.css">
<body>
    <%- include('nav-bar') %>
    <a href="/" class="btn-voltar">⬅️ Voltar</a>

    <main class="game-container">
        <!-- Lado Esquerdo: Mascote e Animações -->
        <div class="game-mascot-area">
            <img src="/assets/img/Normal.png" alt="Mascote EduCão" id="img-educao-logica">
        </div>

        <!-- Lado Direito: Conteúdo do Jogo -->
        <div class="game-content">
            <h1 class="display-5 fw-bold text-warning mb-3">Aventuras do Educão 🐶</h1>
            
            <div class="progress-info mx-auto">
                <span id="progresso-texto" class="text-light">Fase 1 de 5</span>
                <div class="progress-bar-bg">
                    <div id="progress-fill"></div>
                </div>
            </div>

            <div id="mensagem" class="my-3 text-light fw-bold">Escreva os comandos para pegar o osso!</div>

            <div id="tabuleiro"></div>

            <div id="controles" style="width: 100%; max-width: 400px;">
                <p class="text-light small mb-2">💡 Dica para experts: use <b>repetir(3, andar(1))</b></p>
                <textarea id="codigo" class="form-control mb-3" placeholder="Ex:&#10;repetir(3, andar(1))&#10;virar('Sul')&#10;pular()"></textarea>
                <button class="btn-resposta w-100" onclick="lerEExecutar()">Executar Código</button>
            </div>
            
            <p id="resultado" class="mt-3"></p>
        </div>
    </main>

    <%- include('includes/footer') %>
    <script src="/assets/js/logicgame.js"></script>
</body>
</html>
