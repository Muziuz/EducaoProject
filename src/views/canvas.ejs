<%- include('includes/head') %>
<style>
    /* Estilos específicos para o Quadro de Artes */
    .canvas-container {
        background-color: #fff;
        border: 8px solid #facc15;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        cursor: crosshair;
        touch-action: none; /* Melhora suporte para tablets */
        max-width: 100%;
        height: auto !important;
    }

    .toolbar-artes {
        background: #0f172a;
        padding: 20px;
        border-radius: 15px;
        border: 2px solid #334155;
        width: 100%;
        max-width: 600px;
    }

    .color-swatch {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        border: 2px solid white;
        cursor: pointer;
        transition: transform 0.2s;
    }

    .color-swatch:hover {
        transform: scale(1.2);
    }

    .brush-size-btn {
        background: #334155;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 5px 15px;
        cursor: pointer;
    }

    .brush-size-btn.active {
        background: #facc15;
        color: #000;
        font-weight: bold;
    }
</style>

<body>
    <%- include('nav-bar') %>
    <a href="/" class="btn-voltar">⬅️ Voltar</a>

    <main class="game-container">
        <!-- Lado Esquerdo: Mascote e Missões -->
        <div class="game-mascot-area" style="position: relative; overflow: hidden; background-color: #0f172a;">
            <img src="/assets/img/Normal.png" alt="Mascote EduCão" id="img-educao-artes" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.9;">
            
            <!-- Overlay de Missões (Azul Escuro para combinar com o tema) -->
            <div style="position: absolute; bottom: 0; left: 0; width: 100%; background: rgba(30, 41, 59, 0.95); padding: 20px; text-align: center; border-top: 4px solid #facc15; box-shadow: 0 -5px 15px rgba(0,0,0,0.3);">
                <div id="missao-container">
                    <h5 class="text-warning fw-bold mb-1">Missão do EduCão 🐾</h5>
                    <p id="texto-missao" class="text-white small mb-3">Clique no botão para começar um desafio!</p>
                    <div class="d-flex justify-content-center gap-2">
                        <button class="btn btn-warning btn-sm fw-bold" id="btnNovaMissao">🎯 Nova Missão</button>
                        <button class="btn btn-success btn-sm fw-bold" id="btnVerificar" style="display: none;">✅ Pronto!</button>
                    </div>
                </div>
                
                <div class="d-flex justify-content-center gap-2 mt-3 pt-2" style="border-top: 1px solid #334155;">
                    <button class="btn btn-outline-danger btn-sm" id="btnLimpar">🗑️ Limpar</button>
                    <button class="btn btn-outline-success btn-sm" id="btnSalvar">💾 Salvar</button>
                </div>
            </div>
        </div>

        <!-- Lado Direito: Quadro e Ferramentas -->
        <div class="game-content">
            <canvas id="telaPintura" class="canvas-container mb-4" width="700" height="450"></canvas>

            <div class="toolbar-artes">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <!-- Cores -->
                    <div class="d-flex gap-2">
                        <div class="color-swatch" style="background: #000000;" data-color="#000000"></div>
                        <div class="color-swatch" style="background: #ef4444;" data-color="#ef4444"></div>
                        <div class="color-swatch" style="background: #3b82f6;" data-color="#3b82f6"></div>
                        <div class="color-swatch" style="background: #22c55e;" data-color="#22c55e"></div>
                        <div class="color-swatch" style="background: #facc15;" data-color="#facc15"></div>
                        <input type="color" id="seletorCor" class="form-control form-control-color" style="width: 35px; height: 35px; padding: 0; border: 2px solid white; border-radius: 50%;">
                    </div>

                    <!-- Tamanho do Pincel -->
                    <div class="d-flex gap-2 align-items-center">
                        <span class="text-light small">Pincel:</span>
                        <button class="brush-size-btn active" data-size="5">P</button>
                        <button class="brush-size-btn" data-size="15">M</button>
                        <button class="brush-size-btn" data-size="30">G</button>
                    </div>

                    <!-- Ferramentas Extras -->
                    <div class="d-flex gap-2">
                        <button id="btnBalde" class="btn btn-outline-light btn-sm" title="Pintar área inteira">🪣 Balde</button>
                        <button id="btnBorracha" class="btn btn-outline-light btn-sm">🧽 Borracha</button>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('includes/footer') %>
    <script src="/assets/js/canva.js"></script>
</body>
</html>
